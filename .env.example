# AlphaSignal Environment Variables
# Copy this file to .env and fill in your values

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required. Used for text-embedding-3-small (embeddings) and gpt-5.6-luna (RAG
# generation / sentiment) - see config.yaml's `embeddings`/`generation` blocks.
OPENAI_API_KEY=your_openai_api_key_here

# ── Auth ─────────────────────────────────────────────────────────────────────
# Optional but recommended, even locally. Enables X-API-Key auth on every route
# except /health. Unset = open access (fine for local dev only). AlphaLive must
# be given this same value as its own ALPHASIGNAL_API_KEY to authenticate.
ALPHASIGNAL_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
