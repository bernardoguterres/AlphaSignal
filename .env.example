# AlphaSignal Environment Variables
# Copy this file to .env and fill in your values

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required. Used for text-embedding-ada-002 (chunking) and gpt-4o-mini (RAG generation).
OPENAI_API_KEY=your_openai_api_key_here

# ── Environment ──────────────────────────────────────────────────────────────
ALPHASIGNAL_ENV=development    # development | production

# ── API Server ───────────────────────────────────────────────────────────────
# Host and port the FastAPI server binds to.
# AlphaLab connects to this address via ALPHASIGNAL_URL in its .env.
ALPHASIGNAL_HOST=0.0.0.0
ALPHASIGNAL_PORT=8001
